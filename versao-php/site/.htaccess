# Potato Chat (PHP)
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType text/javascript .js
  AddType application/wasm .wasm
</IfModule>

# Arquivos internos nunca são servidos ao navegador.
<FilesMatch "^(((turn|music)\.)?config\.php|.*\.(md|sql|json|log))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# JS e CSS sempre conferidos com o servidor: depois de atualizar o site, ninguém fica com versão antiga.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|svg|ico|wasm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>
