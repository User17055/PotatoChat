{
  "manifest_version": 3,
  "name": "Potato Chat",
  "version": "2.2.0",
  "description": "Nosso chat no painel lateral: envie textos, links e páginas direto do navegador, e assista Netflix e HBO Max juntos na Batata Watch Party.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*", "https://play.max.com/*", "https://play.hbomax.com/*"],
      "js": ["watch-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["netflix-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir nosso chat",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "omnibox": {
    "keyword": "pc"
  },
  "commands": {
    "toggle-chat": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Mostrar ou esconder nosso chat"
    },
    "_execute_action": {
      "description": "Abrir nosso chat"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src http://localhost:* https:"
  }
}
