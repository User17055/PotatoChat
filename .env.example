PORT=3000
CHAT_PASSWORD=troque-esta-senha
TOKEN_SECRET=troque-por-uma-chave-longa-e-aleatoria
PUBLIC_URL=http://localhost:3000

# Opcional: os dois nomes que podem entrar. Sem isso, os dois primeiros que entrarem ficam registrados em data/users.json.
CHAT_USERS=

# TURN próprio ou de um provedor. Inclua UDP, TCP e TLS para redes restritas.
TURN_URLS=
# coturn com use-auth-secret (o segredo nunca é enviado ao navegador).
TURN_SECRET=
TURN_TTL=3600
# Alternativa para provedores com usuário/senha fixos:
TURN_USERNAME=
TURN_PASSWORD=
TURN_ONLY=false
